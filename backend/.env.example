# ==============================================================================
# LegalMind AI — Environment Configuration
# ==============================================================================

# LLM Provider Configuration (OpenAI-compatible)
PROVIDER=openai

# ------------------------------------------------------------------------------
# Option 1: Groq Cloud (Recommended: 100% Free & Fast, no local GPU/disk required)
# Get a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Option 2: Google Gemini (Free tier with massive context window)
# Get a free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=AIzaSy_your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Option 3: Official OpenAI
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Option 4: Local Ollama (Self-hosted, 100% offline)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=llama3.1

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite (Default: Zero setup, zero installation, lightweight local file)
DATABASE_URL=sqlite:///./legalmind.db

# PostgreSQL (Optional production setup)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/legalmind

# ==============================================================================
# Agent Observability & Tracing (LangSmith — Optional)
# Free account at: https://smith.langchain.com/
# When enabled, LangGraph automatically logs agent execution graphs, latencies, & tokens.
# ==============================================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your_key_here
# LANGCHAIN_PROJECT=legalmind-ai
